APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# CORS for Flutter / external frontends (Bearer token API)
# Use * for local Flutter web, or comma-separated origins in production
CORS_ALLOWED_ORIGINS=*
# CORS_ALLOWED_ORIGINS_PATTERNS=
CORS_SUPPORTS_CREDENTIALS=false
CORS_MAX_AGE=86400

API_VERSION=1.0.0
# Set true on production to open https://your-host/docs/api
SCRAMBLE_DOCS_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=elibra-local
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_REVERB_ENABLED=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/login"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_SUBSCRIPTION_AMOUNT=9.99
STRIPE_SUCCESS_URL="${APP_URL}/dashboard/profile?payment=success"
STRIPE_CANCEL_URL="${APP_URL}/dashboard/profile?payment=cancelled"
# true only if Stripe account has Cambodia KHQR capability
STRIPE_KHQR_ENABLED=false

# ABA PayWay — prefer DB credentials (author / admin is_platform). .env is optional fallback only.
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_API_KEY=
ABA_PAYWAY_SANDBOX=true
ABA_PAYWAY_DEFAULT_CURRENCY=USD
ABA_PAYWAY_MERCHANT_NAME="e-Libra Platform"
ABA_PAYWAY_SANDBOX_BASE_URL=https://checkout-sandbox.payway.com.kh
ABA_PAYWAY_PRODUCTION_BASE_URL=https://checkout.payway.com.kh
ABA_PAYWAY_SUCCESS_URL="${APP_URL}/profile?payment=success&provider=payway"
ABA_PAYWAY_CANCEL_URL="${APP_URL}/profile?payment=cancelled&provider=payway"
ABA_PAYWAY_RETURN_URL="${APP_URL}/api/v1/payway/callback"
ABA_PAYWAY_VIEW_TYPE=hosted_view
ABA_PAYWAY_QR_IMAGE_TEMPLATE=template3_color
ABA_PAYWAY_QR_LIFETIME_MINUTES=30

ADMIN_COMMISSION_RATE=10

# Free preview pages for paid books (recommended 10–20)
BOOK_TRIAL_PAGES=15
# Max book PDF upload size in kilobytes (524288 = 512 MB). Also raise PHP upload_max_filesize / post_max_size.
BOOK_PDF_MAX_KB=524288

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=true
